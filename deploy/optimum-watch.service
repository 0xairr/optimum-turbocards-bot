[Unit]
Description=Optimum TurboCards FCFS code watcher and auto-minter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/optimum-watch
Environment=HOME=/home/ubuntu
Environment=PYTHONUTF8=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/optimum-watch/.venv/bin/python -u /home/ubuntu/optimum-watch/optimum_bot.py
Restart=always
RestartSec=3
TimeoutStopSec=12
KillMode=control-group
MemoryMax=256M
CPUQuota=50%
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/optimum-watch
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
